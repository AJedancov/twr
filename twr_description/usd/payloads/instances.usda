def Scope "Instances"
{
    def Xform "twr_base" (
        prepend references = @./geometries.usd@</Geometries/twr_base>
    )
    {
        over "twr_base" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/twr_base/VisualMaterials/Body001>
        }

        def Scope "VisualMaterials"
        {
            def Material "Body001" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/Body001>
            )
            {
            }
        }
    }

    def Xform "twr_base_1" (
        prepend references = @./geometries.usd@</Geometries/twr_base>
    )
    {
        over "twr_base" (
            apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            token physics:approximation = "convexHull"
            token purpose = "guide"
        }
    }
}

